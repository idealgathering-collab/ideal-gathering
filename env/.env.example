# Public build-time settings. Supply your isolated backend; never a service key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SITE_URL=
VITE_OAUTH_PROVIDER=supabase
# Public P-256 VAPID key only. Blank disables subscription creation safely.
VITE_WEB_PUSH_VAPID_PUBLIC_KEY=
# Optional public branding (empty values use Ideal Gathering defaults)
VITE_BRAND_NAME=
VITE_BRAND_SHORT_NAME=
VITE_BRAND_LOGO_URL=
VITE_BRAND_TAGLINE=
VITE_BRAND_DESCRIPTION=
VITE_BRAND_THEME_COLOR=
# SERVER ONLY: inject via the process environment when starting Node.
# SUPABASE_URL
# SUPABASE_PUBLISHABLE_KEY
# SUPABASE_SERVICE_ROLE_KEY
# HOST
# PORT
